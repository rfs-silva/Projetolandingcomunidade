# =============================================================================
# Configuração de produção — Comunidade Roraima Fullstack Developers
# =============================================================================
# Copie este arquivo como `.env` no servidor de produção e preencha os valores.
# NUNCA commite o `.env` com valores reais.
#
# Setup: frontend em https://rrfullstack.sistemasme.com, API em
# https://api-rrfullstack.sistemasme.com, ambos apontando pro mesmo app
# Next.js atrás de Caddy/nginx fazendo TLS.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=production

# -----------------------------------------------------------------------------
# Auth.js
# -----------------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=__TROCAR_POR_BASE64_RANDOMICO_DE_32_BYTES__

# URL base usada pelo Auth.js pra montar callback URLs e validar host.
AUTH_URL=https://rrfullstack.sistemasme.com
AUTH_TRUST_HOST=true

# Compartilhar cookie de sessão entre rrfullstack.sistemasme.com e
# api-rrfullstack.sistemasme.com — usa o apex precedido de ponto.
AUTH_COOKIE_DOMAIN=.sistemasme.com

# OAuth App de PRODUÇÃO (separado do dev).
# Callback URL no GitHub: https://rrfullstack.sistemasme.com/api/auth/callback/github
AUTH_GITHUB_ID=__client_id_de_prod__
AUTH_GITHUB_SECRET=__client_secret_de_prod__

# Login dev de empresa (sem magic link) — deixe vazio/false em prod.
# Tela /empresa/login mostra "em desenvolvimento" enquanto não tem magic link.
ENABLE_DEV_COMPANY_LOGIN=false

# -----------------------------------------------------------------------------
# Banco de dados (Postgres gerenciado, ex.: Neon/Supabase free tier)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require

# Bootstrap inicial controlado: setar true APENAS na primeira execução em
# DB vazio. Após isso, manter ausente/false.
RUN_SEED=

# -----------------------------------------------------------------------------
# URLs públicas (sitemap, OpenAPI, canonical, CSP)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rrfullstack.sistemasme.com
NEXT_PUBLIC_API_URL=https://api-rrfullstack.sistemasme.com

# Origens autorizadas a fazer CORS no /api (frontend + integrações suas).
# Separadas por vírgula, SEM espaço extra.
ALLOWED_ORIGINS=https://rrfullstack.sistemasme.com,https://api-rrfullstack.sistemasme.com

# -----------------------------------------------------------------------------
# LGPD
# -----------------------------------------------------------------------------
# Email do encarregado de dados (DPO). Aparece em /privacidade, /termos,
# no payload de export LGPD e como contact no OpenAPI.
DPO_EMAIL=privacidade@sistemasme.com
