# ============================================================================
# Banco de dados (Postgres)
# ============================================================================
DATABASE_URL="postgresql://comunidade:comunidade@localhost:5432/comunidade?schema=public"

# Credenciais usadas pelo container do Postgres no docker-compose.
POSTGRES_USER=comunidade
POSTGRES_PASSWORD=comunidade
POSTGRES_DB=comunidade
POSTGRES_PORT=5432

# ============================================================================
# Auth.js (NextAuth v5)
# ============================================================================
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# GitHub OAuth App
# Crie em: https://github.com/settings/developers → New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
