// Schema do MVP - Comunidade Roraima Fullstack Developers
// Cobre: users, profiles, tags, events, challenges, projects, mentorship.
// Tabelas anotadas com [E1..E7] indicam o epico que primeiro as consome.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum EventType {
  REMOTO
  PRESENCIAL
}

enum Visibility {
  PUBLIC
  MEMBERS
}

enum ProjectCategoryDb {
  FRONTEND
  BACKEND
  MOBILE
  FULLSTACK
}

enum ProfileType {
  MEMBER
  COMPANY
  LEADER
  FOUNDER
}

enum TagCategory {
  STACK
  TOPIC
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  ACCEPTED
  REJECTED
}

enum MentorshipKind {
  MENTOR
  MENTEE
}

enum ForumCategory {
  GERAL
  ANUNCIOS
  AJUDA
  CARREIRA
  OFF_TOPIC
}

enum PrivacyEventType {
  TERMS_ACCEPTED
  DATA_EXPORTED
  ACCOUNT_DELETED
  PROFILE_TYPE_CHANGED
}

enum ChallengeParticipationStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum EventRegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

// ============================================================================
// E1 - Auth & Users
// ============================================================================

model User {
  id              String    @id @default(uuid())
  githubId        String?   @unique
  githubUsername  String?   @unique
  email           String?   @unique
  avatarUrl       String?
  acceptedTermsAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile                 Profile?
  mentorshipApplications  MentorshipApplication[]
  projects                UserProject[]
  forumThreads            ForumThread[]
  forumReplies            ForumReply[]
  challengeParticipations ChallengeParticipation[]
  eventRegistrations      EventRegistration[]
  reviewedCompanies       CompanyApplication[]      @relation("CompanyApplicationReviewer")
}

model Profile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  bio              String?
  linkedinUrl      String?
  type             ProfileType  @default(MEMBER)
  location         String?
  featuredAsLeader Boolean      @default(false)
  leaderRole       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tags             ProfileTag[]

  @@index([type])
  @@index([featuredAsLeader])
}

// ============================================================================
// E3/E4 - Tags (Stack e Topicos)
// ============================================================================

model Tag {
  id        String           @id @default(uuid())
  slug      String           @unique
  label     String
  category  TagCategory      @default(STACK)
  createdAt DateTime         @default(now())

  profiles    ProfileTag[]
  projectTags UserProjectTag[]
}

model ProfileTag {
  profileId String
  tagId     String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
  @@index([tagId])
}

// ============================================================================
// E5 - Eventos
// ============================================================================

model Event {
  id          String     @id @default(uuid())
  number      String     @unique
  title       String
  description String
  dateFull    String
  dateShort   String
  type        EventType
  visibility  Visibility          @default(PUBLIC)
  imageIndex  Int
  points      Int                 @default(10)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  registrations EventRegistration[]

  @@index([visibility])
  @@index([type])
}

// ============================================================================
// E5 - Desafios
// ============================================================================

model Challenge {
  id            String                    @id @default(uuid())
  number        String                    @unique
  title         String
  description   String
  imageIndex    Int
  visibility    Visibility                @default(PUBLIC)
  points        Int                       @default(20)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  tags          ChallengeTag[]
  participations ChallengeParticipation[]

  @@index([visibility])
}

model ChallengeTag {
  id          String    @id @default(uuid())
  challengeId String
  iconName    String
  label       String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

// ============================================================================
// E7 - Projetos (vitrine)
// ============================================================================

model UserProject {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String
  authorAvatar String?
  image        String?
  category     ProjectCategoryDb
  demoUrl      String?
  repoUrl      String?
  visibility   Visibility        @default(MEMBERS)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tags         UserProjectTag[]

  @@index([category])
  @@index([visibility])
  @@index([userId])
}

model UserProjectTag {
  projectId String
  tagId     String
  project   UserProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
}

// ============================================================================
// E6 - Mentoria (candidatura)
// ============================================================================

model MentorshipApplication {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         MentorshipKind    @default(MENTEE)
  goal         String
  availability String
  stack        String
  status       ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, kind])
  @@index([status])
}

// ============================================================================
// Forum (Pos-MVP - threads + replies)
// ============================================================================

model ForumThread {
  id           String        @id @default(uuid())
  authorId     String
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  body         String
  category     ForumCategory @default(GERAL)
  isPinned     Boolean       @default(false)
  isLocked     Boolean       @default(false)
  repliesCount Int           @default(0)
  lastReplyAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  replies      ForumReply[]

  @@index([category])
  @@index([isPinned, lastReplyAt(sort: Desc)])
  @@index([authorId])
}

model ForumReply {
  id        String      @id @default(uuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([threadId, createdAt])
  @@index([authorId])
}

// ============================================================================
// LGPD - Registro de operações de tratamento (art. 37)
// ============================================================================
// Conserva subjectGithubId mesmo após exclusão da conta para fins de comprovação
// junto à ANPD. Não tem FK para User para sobreviver à exclusão em cascade.

model PrivacyEvent {
  id               String           @id @default(uuid())
  type             PrivacyEventType
  subjectUserId    String?
  subjectGithubId  String
  subjectUsername  String
  actorUserId      String?
  actorGithubId    String?
  metadata         Json?
  createdAt        DateTime         @default(now())

  @@index([subjectGithubId, createdAt])
  @@index([type, createdAt])
}

// ============================================================================
// Gamificação - participação em desafios e eventos
// ============================================================================

model ChallengeParticipation {
  id             String                       @id @default(uuid())
  userId         String
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId    String
  challenge      Challenge                    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  status         ChallengeParticipationStatus @default(IN_PROGRESS)
  submissionUrl  String?
  submissionNote String?
  reviewerNote   String?
  startedAt      DateTime                     @default(now())
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([userId, challengeId])
  @@index([status])
  @@index([challengeId, status])
}

model EventRegistration {
  id           String                  @id @default(uuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status       EventRegistrationStatus @default(REGISTERED)
  registeredAt DateTime                @default(now())
  attendedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([userId, eventId])
  @@index([status])
  @@index([eventId, status])
}

// ============================================================================
// Onboarding de empresas sem GitHub
// ============================================================================

enum CompanyApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompanyApplication {
  id              String                   @id @default(uuid())
  companyName     String
  contactName     String
  email           String
  website         String?
  linkedinUrl     String?
  description     String
  status          CompanyApplicationStatus @default(PENDING)
  reviewerNote    String?
  reviewedById    String?
  reviewedBy      User?                    @relation("CompanyApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  approvedUserId  String?                  @unique
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// Tabela usada pelo provider de email do Auth.js (magic link).
// Mantida desde já para reduzir migration churn quando ligarmos o email.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
